# Copy to .env for local development (never commit .env).

# Database used by the app and goose. docker-compose publishes PostgreSQL on 5433
# to avoid clashing with a local PostgreSQL on 5432.
DATABASE_URL=postgres://saka:saka@localhost:5433/saka?sslmode=disable

# goose reads these directly (see Makefile).
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://saka:saka@localhost:5433/saka?sslmode=disable
GOOSE_MIGRATION_DIR=migrations
