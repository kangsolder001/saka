{
  "app": {
    "name": "Saka",
    "env": "development",
    "http_addr": ":8080",
    "shutdown_timeout": "15s",
    "log_level": "info",
    "frontend_url": "http://localhost:3000",
    "cors_allowed_origins": ["http://localhost:3000"],
    "trusted_proxies": []
  },
  "database": {
    "url": "postgres://saka:saka@localhost:5433/saka?sslmode=disable",
    "max_conns": 10,
    "min_conns": 0,
    "app_role": "saka_app"
  },
  "auth": {
    "jwt_secret": "change-me-to-a-random-string-of-at-least-32-chars",
    "access_token_ttl": "15m",
    "refresh_token_ttl": "720h"
  },
  "redis": {
    "addr": "localhost:6380",
    "password": "",
    "db": 0,
    "key_prefix": "saka",
    "user_cache_ttl": "5m"
  },
  "mail": {
    "driver": "smtp",
    "from": "Saka <noreply@saka.local>",
    "smtp": {
      "host": "localhost",
      "port": 1025,
      "username": "",
      "password": ""
    }
  },
  "worker": {
    "concurrency": 4,
    "poll_interval": "5s",
    "job_timeout": "1m",
    "lease": "5m"
  }
}
