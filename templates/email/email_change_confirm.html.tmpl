{{define "content"}}
<p>Hi {{.Data.name}},</p>
<p>Someone asked to change the email address of a {{.App.Name}} account to this address. Click the button below to confirm. The link is valid for 24 hours.</p>
<p style="margin:24px 0;"><a href="{{.Data.url}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">Confirm new email</a></p>
<p>If the button doesn't work, copy this link into your browser:<br><a href="{{.Data.url}}">{{.Data.url}}</a></p>
<p>If you didn't request this, you can ignore this email. The account email will not change.</p>
{{end}}
{{template "layout" .}}
