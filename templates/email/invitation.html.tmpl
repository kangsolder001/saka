{{define "content"}}
<p>Hi,</p>
<p>{{.Data.inviter_name}} has invited you to join the organization <strong>{{.Data.organization_name}}</strong> on {{.App.Name}} as {{.Data.role_label}}. Click the button below to view and accept the invitation. The link is valid for {{.Data.expires_in_days}} days.</p>
<p style="margin:24px 0;"><a href="{{.Data.url}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">View invitation</a></p>
<p>If the button doesn't work, copy this link into your browser:<br><a href="{{.Data.url}}">{{.Data.url}}</a></p>
<p>You need to log in or sign up with this email address to accept the invitation. If you don't know the person who invited you, you can ignore this email.</p>
{{end}}
{{template "layout" .}}
