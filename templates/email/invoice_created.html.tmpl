{{define "content"}}
<p>Hi {{.Data.name}},</p>
<p>Invoice <strong>{{.Data.invoice_number}}</strong> for the organization <strong>{{.Data.organization_name}}</strong> has been issued: the {{.Data.plan_name}} plan for <strong>{{.Data.amount}}</strong>. Please pay it before {{.Data.due_date}}.</p>
<p style="margin:24px 0;"><a href="{{.Data.payment_url}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">Pay now</a></p>
<p>If the button doesn't work, copy this link into your browser:<br><a href="{{.Data.payment_url}}">{{.Data.payment_url}}</a></p>
<p>The new plan takes effect once we receive your payment. If you didn't create this invoice, you can ignore this email.</p>
{{end}}
{{template "layout" .}}
