{{define "content"}}
<p>Halo {{.Data.name}},</p>
<p>Pengingat: invoice <strong>{{.Data.invoice_number}}</strong> untuk organisasi <strong>{{.Data.organization_name}}</strong> (paket {{.Data.plan_name}}, <strong>{{.Data.amount}}</strong>) jatuh tempo pada <strong>{{.Data.due_date}}</strong>, {{.Data.days_left}} hari lagi.</p>
<p style="margin:24px 0;"><a href="{{.Data.payment_url}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">Bayar sekarang</a></p>
<p>Jika tombol tidak berfungsi, salin tautan ini ke browser Anda:<br><a href="{{.Data.payment_url}}">{{.Data.payment_url}}</a></p>
<p>Jika invoice sudah dibayar, abaikan email ini.</p>
{{end}}
{{template "layout" .}}
