{{define "content"}}
<p>Hi {{.Data.name}},</p>
<p>We have received your payment of <strong>{{.Data.amount}}</strong> for invoice <strong>{{.Data.invoice_number}}</strong>. Thank you!</p>
<p>The organization <strong>{{.Data.organization_name}}</strong> is now subscribed to the {{.Data.plan_name}} plan until {{.Data.period_end}}.</p>
<p>Keep this email as your payment receipt.</p>
{{end}}
{{template "layout" .}}
