{{define "content"}}
<p>Hi {{.Data.name}},</p>
<p>Thanks for signing up for {{.App.Name}}. Click the button below to verify your email address. The link is valid for 24 hours.</p>
<p style="margin:24px 0;"><a href="{{.Data.url}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">Verify email</a></p>
<p>If the button doesn't work, copy this link into your browser:<br><a href="{{.Data.url}}">{{.Data.url}}</a></p>
<p>If you didn't sign up, you can ignore this email.</p>
{{end}}
{{template "layout" .}}
