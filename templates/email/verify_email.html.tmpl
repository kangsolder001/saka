{{define "content"}}
<p>Halo {{.Data.name}},</p>
<p>Terima kasih sudah mendaftar di {{.App.Name}}. Klik tombol di bawah untuk memverifikasi alamat email Anda. Tautan berlaku selama 24 jam.</p>
<p style="margin:24px 0;"><a href="{{.Data.url}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">Verifikasi email</a></p>
<p>Jika tombol tidak berfungsi, salin tautan ini ke browser Anda:<br><a href="{{.Data.url}}">{{.Data.url}}</a></p>
<p>Jika Anda tidak merasa mendaftar, abaikan email ini.</p>
{{end}}
{{template "layout" .}}
